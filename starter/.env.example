# Local-only connection for the provided Docker Compose setup.
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

# Choose ONE provider if you use an API; local embeddings do not need an API key.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_MODEL=

# Embedding provider: local (default, no key) | openrouter | openai
EMBEDDING_PROVIDER=local
# local default (leave EMBEDDING_MODEL empty): ../models/multilingual-e5-base (768d). API example: openai/text-embedding-3-small
